{
  "name": "vumeto-desktop",
  "version": "0.2.7",
  "description": "Vumeto Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder build --publish never",
    "prebuild:win": "electron-rebuild",
    "build:win": "electron-builder build --win --publish never",
    "build:mac": "electron-builder build --mac --publish never",
    "build:linux": "electron-builder build --linux --publish never",
    "publish": "electron-builder build --publish always"
  },
  "keywords": [],
  "author": "Vumeto",
  "license": "GPL-3.0",
  "repository": "https://github.com/vumeto/desktop",
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "cors": "^2.8.5",
    "discord-rpc": "^4.0.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.1.7",
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.vumeto.desktop",
    "productName": "Vumeto",
    "copyright": "Copyright © 2026 Vumeto",
    "icon": "assets/icon",
    "asar": true,
    "protocols": [
      {
        "name": "Vumeto",
        "schemes": [
          "vumeto"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "vumeto",
        "repo": "desktop",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "assets/icons/filled/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icons/filled/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons/filled",
      "category": "Multimedia"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
