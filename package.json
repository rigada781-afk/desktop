{
  "name": "aniverse-desktop",
  "version": "0.3.5",
  "description": "Aniverse Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "bun test",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.js",
    "build": "node scripts/fetch-ffmpeg.js && electron-builder build --publish never",
    "build:win": "node scripts/fetch-ffmpeg.js win && electron-builder build --win --publish never",
    "build:mac": "node scripts/fetch-ffmpeg.js mac && electron-builder build --mac --publish never",
    "build:linux": "node scripts/fetch-ffmpeg.js linux && electron-builder build --linux --publish never",
    "publish": "node scripts/fetch-ffmpeg.js && electron-builder build --publish always"
  },
  "keywords": [],
  "author": "Aniverse",
  "license": "GPL-3.0",
  "repository": "https://github.com/rigada781-afk/desktop",
  "trustedDependencies": [
    "electron",
    "ffmpeg-static"
  ],
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^24.9.1",
    "ffmpeg-static": "^5.3.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "discord-rpc": "^4.0.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.1.7",
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.aniverse.desktop",
    "productName": "Aniverse",
    "copyright": "Copyright © 2026 Aniverse",
    "icon": "assets/icon",
    "asar": true,
    "files": [
      "!vendor{,/**/*}",
      "!scripts{,/**/*}",
      "!tests{,/**/*}",
      "!.claude{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg/${os}-${arch}",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      }
    ],
    "protocols": [
      {
        "name": "Aniverse",
        "schemes": [
          "aniverse"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "avm",
        "name": "Chapitre Aniverse",
        "description": "Chapitre de manga téléchargé sur Aniverse",
        "mimeType": "application/x-aniverse-manga",
        "role": "Viewer",
        "icon": "assets/icons/avm/avm"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "aniverse",
        "repo": "desktop",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "assets/icons/filled/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icons/filled/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons/filled",
      "category": "Multimedia"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
